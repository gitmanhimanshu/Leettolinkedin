# ==========================================
# Code2LinkedIn Environment Variables Template
# ==========================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["chrome-extension://*", "http://localhost:8000", "http://127.0.0.1:8000"]
API_SHARED_SECRET=code2linkedin-dev-secret-token

# Phase 5: xAI Grok API Configuration
# Get your API key from https://console.x.ai/
XAI_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Phase 6: Cloudinary Configuration
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Phase 6: MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=code2linkedin

# Phase 7: LinkedIn API & OAuth 2.0 Configuration
# App registration at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_SCOPE=openid profile w_member_social
LINKEDIN_DRAFT_MODE=True
