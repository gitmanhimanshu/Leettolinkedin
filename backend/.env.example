# ==========================================
# Code2LinkedIn Backend Environment Variables
# ==========================================

PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["chrome-extension://*", "http://localhost:8000", "http://127.0.0.1:8000"]
API_SHARED_SECRET=code2linkedin-dev-secret-token

# Phase 5: xAI Grok API Configuration
XAI_API_KEY=
GROK_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Phase 6: Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 6: MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=code2linkedin

# Phase 7: LinkedIn API & OAuth 2.0 Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_SCOPE=openid profile w_member_social
LINKEDIN_DRAFT_MODE=True
